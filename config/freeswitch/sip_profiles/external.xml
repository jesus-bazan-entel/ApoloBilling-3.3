<include>
  <!--
    External SIP profile: FreeSWITCH <-> Kamailio trunk bus.
    Port 5062 on the LAN. Outbound customer calls are bridged here via the
    'kamailio' gateway; inbound traffic from Kamailio (carrier-originated)
    enters the 'from-kamailio' context.
    IP is rewritten at install time by deploy_apolo_configs().
  -->
  <profile name="external">
    <settings>
      <param name="sip-ip" value="10.118.0.6"/>
      <param name="sip-port" value="5062"/>
      <param name="rtp-ip" value="10.118.0.6"/>

      <param name="context" value="from-kamailio"/>
      <param name="dialplan" value="XML"/>

      <param name="disable-register" value="true"/>

      <!-- RTPEngine authoritative: never bypass. -->
      <param name="inbound-bypass-media" value="false"/>
      <param name="bypass-media-after-bridge" value="false"/>
      <!-- Hang up calls whose RTP stopped (dead peer, lost BYE): 300 s without packets, 1800 s on hold (vanilla values) -->
      <param name="rtp-timeout-sec" value="300"/>
      <param name="rtp-hold-timeout-sec" value="1800"/>

      <param name="enable-100rel" value="true"/>
      <param name="auto-answer-100rel" value="true"/>

      <param name="enable-timer" value="true"/>
      <param name="session-timeout" value="1800"/>
      <param name="minimum-session-expires" value="120"/>

      <param name="auth-calls" value="false"/>
      <param name="apply-inbound-acl" value="kamailio-acl"/>

      <param name="local-network-acl" value="localnet.auto"/>
      <param name="manage-presence" value="false"/>

      <param name="debug" value="0"/>
      <param name="sip-trace" value="no"/>
    </settings>

    <gateways>
      <X-PRE-PROCESS cmd="include" data="external/gateways/*.xml"/>
    </gateways>
  </profile>
</include>
