<?xml version="1.0" encoding="utf-8"?>
<configuration name="acl.conf" description="Network Lists">
  <network-lists>

    <!-- ACL para PBX -->
    <list name="pbx-acl" default="deny">
      <node type="allow" cidr="172.16.1.25/32"/>
      <node type="allow" cidr="10.212.134.0/24"/>
    </list>

    <!-- ACL para Kamailio - Todas las interfaces -->
    <list name="kamailio-acl" default="deny">
      <node type="allow" cidr="10.10.22.4/32"/>
      <node type="allow" cidr="10.124.194.14/32"/>
      <node type="allow" cidr="127.0.0.1/32"/>
    </list>

    <!-- Red local automática -->
    <list name="localnet.auto" default="allow">
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="10.0.0.0/8"/>
    </list>

  </network-lists>
</configuration>

